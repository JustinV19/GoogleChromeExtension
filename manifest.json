{
  "manifest_version": 3,
  "name": "RechnungerstellerFürCardmarket",
  "version": "1.0",
  "description":"Eigene Rechnungen erstellen, direkt und unkompliziert. Durch ein Knopfdruck",
  "action":{
    "default_popup": "popup.html"
  },
  "icons":{
    "128": "icons/Lacrima(Playmat).png"
  },
   "permissions": [
    "storage"
  ],
  "content_scripts":[
    {
      "matches": ["https://www.cardmarket.com/de/YuGiOh/Orders/*"],
      "js":["html2pdf.bundle.js","content.js"]
      
    }
  ],
  
   "web_accessible_resources": [
    {
      "resources": [
        "pdfTemplate.html",
        "pdfTemplate.js",
        "pdfTemplate.css",
        "icons/*"
      ],

      "matches": [
        "<all_urls>"
      ]
    }
  ]
}